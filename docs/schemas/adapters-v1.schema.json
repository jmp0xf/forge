{
  "$id": "forge.adapters/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Forge adapters v1",
  "description": "Common JSON envelope for every machine-readable command result.",
  "type": "object",
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      }
    },
    "data": {
      "$ref": "#/$defs/AdaptersData"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Diagnostic"
      }
    },
    "ok": {
      "type": "boolean"
    },
    "schema": {
      "type": "string",
      "const": "forge.adapters/v1"
    },
    "tool_version": {
      "type": "string"
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "schema",
    "tool_version",
    "ok",
    "data",
    "diagnostics",
    "truncated",
    "artifacts"
  ],
  "$defs": {
    "AdapterDriftData": {
      "description": "Adapter drift classification.",
      "type": "string",
      "enum": [
        "asset-changed",
        "user-edited",
        "generated-missing",
        "manifest-stale",
        "no-drift",
        "unknown"
      ]
    },
    "AdapterStatusData": {
      "type": "object",
      "properties": {
        "block_id": {
          "$ref": "#/$defs/ManagedBlockId"
        },
        "detail": {
          "type": "string"
        },
        "drift": {
          "$ref": "#/$defs/AdapterDriftData"
        },
        "host": {
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/WirePath"
        }
      },
      "required": [
        "host",
        "path",
        "block_id",
        "drift",
        "detail"
      ]
    },
    "AdaptersData": {
      "description": "Root data for adapter sync/check results.",
      "type": "object",
      "properties": {
        "adapters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AdapterStatusData"
          }
        },
        "applied": {
          "type": "boolean"
        },
        "changed": {
          "type": "boolean"
        }
      },
      "required": [
        "adapters",
        "changed",
        "applied"
      ]
    },
    "ArtifactRef": {
      "description": "A file or state artifact referenced by a command result.",
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/WirePath"
        }
      },
      "required": [
        "kind",
        "path",
        "description"
      ]
    },
    "Diagnostic": {
      "description": "An actionable diagnostic with all mandatory explanatory fields.",
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/DiagnosticCode"
        },
        "next": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "what": {
          "type": "string"
        },
        "where": {
          "type": "string"
        },
        "why": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "what",
        "where",
        "why",
        "next"
      ]
    },
    "DiagnosticCode": {
      "description": "Stable FGE diagnostic code.",
      "type": "string"
    },
    "ManagedBlockId": {
      "description": "Stable managed-block identity.",
      "type": "string"
    },
    "PathEncoding": {
      "description": "Encoding used to preserve a native path on the wire.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "utf8",
            "unix-bytes",
            "windows-wide"
          ]
        },
        {
          "description": "A future encoding that this binary cannot safely interpret.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "Severity": {
      "description": "Diagnostic severity. Unknown future values fail closed in consumers.",
      "type": "string",
      "enum": [
        "info",
        "warning",
        "error",
        "unknown"
      ]
    },
    "WirePath": {
      "description": "A displayable and, when needed, lossless path representation.",
      "type": "object",
      "properties": {
        "display": {
          "type": "string"
        },
        "encoding": {
          "$ref": "#/$defs/PathEncoding"
        },
        "raw_base64": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "display",
        "encoding"
      ]
    }
  }
}
