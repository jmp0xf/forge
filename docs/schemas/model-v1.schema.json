{
  "$id": "forge.model/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Forge model v1",
  "description": "Common JSON envelope for every machine-readable command result.",
  "type": "object",
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      }
    },
    "data": {
      "$ref": "#/$defs/ProjectModelData"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Diagnostic"
      }
    },
    "ok": {
      "type": "boolean"
    },
    "schema": {
      "type": "string",
      "const": "forge.model/v1"
    },
    "tool_version": {
      "type": "string"
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "schema",
    "tool_version",
    "ok",
    "data",
    "diagnostics",
    "truncated",
    "artifacts"
  ],
  "$defs": {
    "AdapterData": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/WirePath"
        },
        "status": {
          "$ref": "#/$defs/AdapterDriftData"
        }
      },
      "required": [
        "host",
        "path",
        "status"
      ]
    },
    "AdapterDetailData": {
      "description": "Structured evidence that accompanies one legacy adapter projection.",
      "type": "object",
      "properties": {
        "confidence": {
          "$ref": "#/$defs/ConfidenceData"
        },
        "host": {
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/WirePath"
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProvenanceData"
          }
        },
        "status": {
          "$ref": "#/$defs/AdapterDriftData"
        }
      },
      "required": [
        "host",
        "path",
        "status",
        "provenance",
        "confidence"
      ]
    },
    "AdapterDriftData": {
      "description": "Adapter drift classification.",
      "type": "string",
      "enum": [
        "asset-changed",
        "user-edited",
        "generated-missing",
        "manifest-stale",
        "no-drift",
        "unknown"
      ]
    },
    "ArtifactRef": {
      "description": "A file or state artifact referenced by a command result.",
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/WirePath"
        }
      },
      "required": [
        "kind",
        "path",
        "description"
      ]
    },
    "AssetData": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/WirePath"
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "kind",
        "path",
        "provenance"
      ]
    },
    "AssetDetailData": {
      "description": "Structured evidence that accompanies one legacy asset projection.",
      "type": "object",
      "properties": {
        "confidence": {
          "$ref": "#/$defs/ConfidenceData"
        },
        "kind": {
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/WirePath"
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProvenanceData"
          }
        }
      },
      "required": [
        "kind",
        "path",
        "provenance",
        "confidence"
      ]
    },
    "AssumptionData": {
      "description": "A fact that could not be proven directly from repository inputs.",
      "type": "object",
      "properties": {
        "confidence": {
          "$ref": "#/$defs/ConfidenceData"
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "statement": {
          "type": "string"
        }
      },
      "required": [
        "statement",
        "provenance",
        "confidence"
      ]
    },
    "AssumptionDetailData": {
      "description": "Structured evidence that accompanies one legacy assumption projection.",
      "type": "object",
      "properties": {
        "confidence": {
          "$ref": "#/$defs/ConfidenceData"
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProvenanceData"
          }
        },
        "statement": {
          "type": "string"
        }
      },
      "required": [
        "statement",
        "provenance",
        "confidence"
      ]
    },
    "CommandData": {
      "description": "A shell-free project command representation.",
      "type": "object",
      "properties": {
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "$ref": "#/$defs/ConfidenceData"
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "$ref": "#/$defs/WirePath"
        },
        "environment_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id": {
          "$ref": "#/$defs/CommandId"
        },
        "intent": {
          "$ref": "#/$defs/IntentData"
        },
        "mutability": {
          "$ref": "#/$defs/MutabilityData"
        },
        "network": {
          "$ref": "#/$defs/NetworkIntentData"
        },
        "program": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "timeout_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "intent",
        "program",
        "args",
        "cwd",
        "environment_names",
        "timeout_seconds",
        "mutability",
        "network",
        "source",
        "confidence",
        "coverage"
      ]
    },
    "CommandDetailData": {
      "description": "Lossless and structured details that accompany a legacy command projection.",
      "type": "object",
      "properties": {
        "command": {
          "$ref": "#/$defs/CommandData"
        },
        "enforcement": {
          "$ref": "#/$defs/CommandEnforcementData",
          "default": "required"
        },
        "native_args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NativeStringData"
          }
        },
        "native_environment_names": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NativeStringData"
          }
        },
        "native_program": {
          "$ref": "#/$defs/NativeStringData"
        },
        "source_detail": {
          "$ref": "#/$defs/CommandSourceData"
        },
        "success": {
          "$ref": "#/$defs/SuccessPredicateData"
        }
      },
      "required": [
        "command",
        "native_program",
        "native_args",
        "native_environment_names",
        "source_detail",
        "success"
      ]
    },
    "CommandEnforcementData": {
      "description": "Whether failure of a command blocks the enclosing verification decision.",
      "type": "string",
      "enum": [
        "required",
        "advisory",
        "unknown"
      ]
    },
    "CommandId": {
      "description": "Stable project-command identity.",
      "type": "string"
    },
    "CommandResolutionData": {
      "description": "Whether a project intent resolved to one authoritative command chain.",
      "type": "string",
      "enum": [
        "resolved",
        "absent",
        "ambiguous",
        "unknown"
      ]
    },
    "CommandSetData": {
      "description": "Complete resolution state for one project intent.",
      "type": "object",
      "properties": {
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CommandDetailData"
          }
        },
        "coverage_confidence": {
          "$ref": "#/$defs/ConfidenceData"
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProvenanceData"
          }
        },
        "resolution": {
          "$ref": "#/$defs/CommandResolutionData"
        },
        "resolution_confidence": {
          "$ref": "#/$defs/ConfidenceData"
        }
      },
      "required": [
        "resolution",
        "candidates",
        "provenance",
        "resolution_confidence",
        "coverage_confidence"
      ]
    },
    "CommandSourceData": {
      "description": "Stable classification of where a project command came from.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "explicit-config"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "existing-project-target"
            },
            "path": {
              "$ref": "#/$defs/WirePath"
            },
            "target": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path",
            "target"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "language-default"
            },
            "provider": {
              "type": "string"
            },
            "rule": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "provider",
            "rule"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "ConfidenceData": {
      "description": "Confidence in a derived fact.",
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ]
    },
    "DerivationEvidenceData": {
      "description": "Provenance and confidence shared by aggregate project-model facts.",
      "type": "object",
      "properties": {
        "confidence": {
          "$ref": "#/$defs/ConfidenceData"
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProvenanceData"
          }
        }
      },
      "required": [
        "provenance",
        "confidence"
      ]
    },
    "Diagnostic": {
      "description": "An actionable diagnostic with all mandatory explanatory fields.",
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/DiagnosticCode"
        },
        "next": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "what": {
          "type": "string"
        },
        "where": {
          "type": "string"
        },
        "why": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "what",
        "where",
        "why",
        "next"
      ]
    },
    "DiagnosticCode": {
      "description": "Stable FGE diagnostic code.",
      "type": "string"
    },
    "Digest": {
      "description": "Versioned content or policy digest.",
      "type": "string"
    },
    "IntentData": {
      "description": "Project operation intent on the wire.",
      "type": "string",
      "enum": [
        "setup",
        "format-check",
        "format",
        "check",
        "fix",
        "test",
        "verify",
        "build",
        "unknown"
      ]
    },
    "MutabilityData": {
      "description": "Declared command mutability.",
      "type": "string",
      "enum": [
        "read-only",
        "working-tree-write",
        "external-side-effect",
        "unknown"
      ]
    },
    "NativeStringData": {
      "description": "A displayable and, when needed, lossless platform-native string.",
      "type": "object",
      "properties": {
        "display": {
          "type": "string"
        },
        "encoding": {
          "$ref": "#/$defs/NativeStringEncodingData"
        },
        "raw_base64": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "display",
        "encoding"
      ]
    },
    "NativeStringEncodingData": {
      "description": "Encoding used to preserve a platform-native string on the wire.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "utf8",
            "unix-bytes",
            "windows-wide"
          ]
        },
        {
          "description": "A future encoding that this binary cannot safely interpret.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "NetworkIntentData": {
      "description": "Declared network behavior; it is not a sandbox guarantee.",
      "type": "string",
      "enum": [
        "inherit",
        "offline-requested",
        "required",
        "unknown"
      ]
    },
    "PathEncoding": {
      "description": "Encoding used to preserve a native path on the wire.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "utf8",
            "unix-bytes",
            "windows-wide"
          ]
        },
        {
          "description": "A future encoding that this binary cannot safely interpret.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "ProjectModelData": {
      "description": "Root data for the detected project model.",
      "type": "object",
      "properties": {
        "adapter_details": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/AdapterDetailData"
          }
        },
        "adapter_inventory_evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/DerivationEvidenceData"
            },
            {
              "type": "null"
            }
          ]
        },
        "adapters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AdapterData"
          }
        },
        "asset_details": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/AssetDetailData"
          }
        },
        "asset_inventory_evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/DerivationEvidenceData"
            },
            {
              "type": "null"
            }
          ]
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssetData"
          }
        },
        "assumption_details": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/AssumptionDetailData"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssumptionData"
          }
        },
        "command_sets": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/CommandSetData"
          }
        },
        "commands": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/CommandData"
            }
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Diagnostic"
          }
        },
        "policy_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy_evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/DerivationEvidenceData"
            },
            {
              "type": "null"
            }
          ]
        },
        "repository": {
          "$ref": "#/$defs/RepoId"
        },
        "repository_evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/DerivationEvidenceData"
            },
            {
              "type": "null"
            }
          ]
        },
        "repository_root": {
          "$ref": "#/$defs/WirePath"
        },
        "unit_details": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/ProjectUnitDetailData"
          }
        },
        "unit_inventory_evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/DerivationEvidenceData"
            },
            {
              "type": "null"
            }
          ]
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProjectUnitData"
          }
        },
        "work_state": {
          "type": "string"
        }
      },
      "required": [
        "repository",
        "repository_root",
        "work_state",
        "units",
        "commands",
        "assets",
        "adapters",
        "assumptions",
        "diagnostics"
      ]
    },
    "ProjectUnitData": {
      "type": "object",
      "properties": {
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UnitId"
          }
        },
        "display_name": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/UnitId"
        },
        "kind": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "manifest": {
          "$ref": "#/$defs/WirePath"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UnitId"
          }
        },
        "root": {
          "$ref": "#/$defs/WirePath"
        },
        "toolchain": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "workspace_root": {
          "anyOf": [
            {
              "$ref": "#/$defs/WirePath"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "display_name",
        "language",
        "kind",
        "root",
        "manifest",
        "members",
        "dependencies",
        "toolchain"
      ]
    },
    "ProjectUnitDetailData": {
      "description": "Structured evidence that accompanies a legacy project-unit projection.",
      "type": "object",
      "properties": {
        "dependency_edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UnitDependencyDetailData"
          }
        },
        "derivation_evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/DerivationEvidenceData"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "$ref": "#/$defs/UnitId"
        },
        "toolchain_evidence": {
          "$ref": "#/$defs/DerivationEvidenceData"
        }
      },
      "required": [
        "id",
        "dependency_edges",
        "toolchain_evidence"
      ]
    },
    "ProvenanceData": {
      "description": "Structured evidence for a derived project-model fact.",
      "type": "object",
      "properties": {
        "detail": {
          "type": "string"
        },
        "rule_id": {
          "type": "string"
        },
        "source_path": {
          "anyOf": [
            {
              "$ref": "#/$defs/WirePath"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextRangeData"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "rule_id",
        "detail"
      ]
    },
    "RepoId": {
      "description": "Stable repository identity.",
      "type": "string"
    },
    "Severity": {
      "description": "Diagnostic severity. Unknown future values fail closed in consumers.",
      "type": "string",
      "enum": [
        "info",
        "warning",
        "error",
        "unknown"
      ]
    },
    "SuccessPredicateData": {
      "description": "Predicate used to decide whether a command observation succeeded.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "exit-zero"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "exit-zero-and-stdout-empty"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "json-has-no-errors"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "all"
            },
            "predicates": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SuccessPredicateData"
              }
            }
          },
          "required": [
            "kind",
            "predicates"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "TextRangeData": {
      "description": "A half-open byte range within a provenance source.",
      "type": "object",
      "properties": {
        "end_byte": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "start_byte": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "start_byte",
        "end_byte"
      ]
    },
    "UnitDependencyDetailData": {
      "description": "Evidence for one dependency edge in a project unit.",
      "type": "object",
      "properties": {
        "confidence": {
          "$ref": "#/$defs/ConfidenceData"
        },
        "dependency": {
          "$ref": "#/$defs/UnitId"
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProvenanceData"
          }
        }
      },
      "required": [
        "dependency",
        "provenance",
        "confidence"
      ]
    },
    "UnitId": {
      "description": "Stable project-unit identity.",
      "type": "string"
    },
    "WirePath": {
      "description": "A displayable and, when needed, lossless path representation.",
      "type": "object",
      "properties": {
        "display": {
          "type": "string"
        },
        "encoding": {
          "$ref": "#/$defs/PathEncoding"
        },
        "raw_base64": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "display",
        "encoding"
      ]
    }
  }
}
