{
  "$id": "forge.doctor/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Forge doctor v1",
  "description": "Common JSON envelope for every machine-readable command result.",
  "type": "object",
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      }
    },
    "data": {
      "$ref": "#/$defs/DoctorData"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Diagnostic"
      }
    },
    "ok": {
      "type": "boolean"
    },
    "schema": {
      "type": "string",
      "const": "forge.doctor/v1"
    },
    "tool_version": {
      "type": "string"
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "schema",
    "tool_version",
    "ok",
    "data",
    "diagnostics",
    "truncated",
    "artifacts"
  ],
  "$defs": {
    "ArtifactRef": {
      "description": "A file or state artifact referenced by a command result.",
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/WirePath"
        }
      },
      "required": [
        "kind",
        "path",
        "description"
      ]
    },
    "AssumptionData": {
      "description": "A fact that could not be proven directly from repository inputs.",
      "type": "object",
      "properties": {
        "confidence": {
          "$ref": "#/$defs/ConfidenceData"
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "statement": {
          "type": "string"
        }
      },
      "required": [
        "statement",
        "provenance",
        "confidence"
      ]
    },
    "CheckStatusData": {
      "description": "Four-state result for an individual doctor check.",
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "skipped",
        "unknown"
      ]
    },
    "ConfidenceData": {
      "description": "Confidence in a derived fact.",
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ]
    },
    "Diagnostic": {
      "description": "An actionable diagnostic with all mandatory explanatory fields.",
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/DiagnosticCode"
        },
        "next": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "what": {
          "type": "string"
        },
        "where": {
          "type": "string"
        },
        "why": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "what",
        "where",
        "why",
        "next"
      ]
    },
    "DiagnosticCode": {
      "description": "Stable FGE diagnostic code.",
      "type": "string"
    },
    "DoctorCheckData": {
      "type": "object",
      "properties": {
        "detail": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "next": {
          "type": "string"
        },
        "skip_reason": {
          "description": "Present exactly when `status` is `skipped` in current Forge output.",
          "anyOf": [
            {
              "$ref": "#/$defs/DoctorSkipReasonData"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/CheckStatusData"
        }
      },
      "required": [
        "id",
        "status",
        "detail",
        "next"
      ]
    },
    "DoctorData": {
      "description": "Root data for `forge doctor`.",
      "type": "object",
      "properties": {
        "assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssumptionData"
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DoctorCheckData"
          }
        },
        "overall": {
          "$ref": "#/$defs/CheckStatusData"
        },
        "tool_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "overall",
        "checks",
        "tool_versions",
        "assumptions"
      ]
    },
    "DoctorSkipReasonData": {
      "description": "Typed reason why a registered doctor check was not evaluated.",
      "type": "string",
      "enum": [
        "user-flag",
        "platform-limitation",
        "budget",
        "unknown"
      ]
    },
    "PathEncoding": {
      "description": "Encoding used to preserve a native path on the wire.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "utf8",
            "unix-bytes",
            "windows-wide"
          ]
        },
        {
          "description": "A future encoding that this binary cannot safely interpret.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "Severity": {
      "description": "Diagnostic severity. Unknown future values fail closed in consumers.",
      "type": "string",
      "enum": [
        "info",
        "warning",
        "error",
        "unknown"
      ]
    },
    "WirePath": {
      "description": "A displayable and, when needed, lossless path representation.",
      "type": "object",
      "properties": {
        "display": {
          "type": "string"
        },
        "encoding": {
          "$ref": "#/$defs/PathEncoding"
        },
        "raw_base64": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "display",
        "encoding"
      ]
    }
  }
}
